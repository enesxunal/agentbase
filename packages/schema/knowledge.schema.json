{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbase.com.tr/schemas/knowledge.schema.json",
  "title": "AgentBase Knowledge Core",
  "type": "object",
  "$defs": {
    "entity": {
      "type": "object",
      "required": ["id", "type", "canonical_name"],
      "properties": {
        "id": {"type": "string"},
        "type": {"type": "string"},
        "canonical_name": {"type": "string"},
        "slug": {"type": "string"},
        "aliases": {"type": "array", "items": {"type": "string"}},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "fact": {
      "type": "object",
      "required": ["id", "subject_entity_id", "predicate", "value", "confidence", "status"],
      "properties": {
        "id": {"type": "string"},
        "subject_entity_id": {"type": "string"},
        "predicate": {"type": "string"},
        "value": {},
        "value_type": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "status": {"enum": ["confirmed", "disproven", "unknown", "conflicting"]},
        "valid_from": {"type": ["string", "null"], "format": "date-time"},
        "valid_to": {"type": ["string", "null"], "format": "date-time"},
        "last_checked_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "relation": {
      "type": "object",
      "required": ["id", "subject_entity_id", "predicate", "object_entity_id", "confidence"],
      "properties": {
        "id": {"type": "string"},
        "subject_entity_id": {"type": "string"},
        "predicate": {"type": "string"},
        "object_entity_id": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "source": {
      "type": "object",
      "required": ["id", "source_type"],
      "properties": {
        "id": {"type": "string"},
        "source_type": {"type": "string"},
        "url": {"type": ["string", "null"], "format": "uri"},
        "publisher": {"type": ["string", "null"]},
        "authority_score": {"type": "number", "minimum": 0, "maximum": 1},
        "retrieved_at": {"type": ["string", "null"], "format": "date-time"}
      }
    }
  }
}
