{
  "name": "agentbase",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -n web,api \"npm run dev -w @agentbase/web\" \"npm run dev -w @agentbase/api\"",
    "dev:local": "DATABASE_URL=postgres://agentbase:agentbase@127.0.0.1:54329/agentbase NEXT_PUBLIC_AGENTBASE_API=http://127.0.0.1:4000 npm run dev",
    "dev:web": "npm run dev -w @agentbase/web",
    "dev:api": "npm run dev -w @agentbase/api",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:logs": "docker compose -f infra/docker-compose.yml logs -f postgres",
    "build": "npm run build -w @agentbase/api && npm run build -w @agentbase/web"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
